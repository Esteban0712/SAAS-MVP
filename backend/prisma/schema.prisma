generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BusinessStatus {
  TRIAL
  ACTIVE
  PAYMENT_PENDING
  SUSPENDED
  CANCELLED
}

enum PlatformUserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentSource {
  WHATSAPP
  ADMIN
  EMPLOYEE
  SYSTEM
}

enum SaleStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum SaleItemType {
  SERVICE
  PRODUCT
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum ReceiptStatus {
  PENDING
  GENERATED
  FAILED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Business {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  slug         String         @unique
  status       BusinessStatus @default(TRIAL)
  timezone     String
  currency     String
  maxUsers     Int
  logoUrl      String?
  taxId        String?
  address      String?
  phone        String?
  settingsJson Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  branches     Branch[]
  users        User[]
  roles        Role[]
  customers    Customer[]
  employees    Employee[]
  services     Service[]
  appointments Appointment[]
  sales        Sale[]
  receipts     Receipt[]
  auditLogs    AuditLog[]

  @@index([status])
}

model Branch {
  id           String        @id @default(uuid()) @db.Uuid
  businessId   String        @db.Uuid
  name         String
  isMain       Boolean       @default(false)
  active       Boolean       @default(true)
  address      String?
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customers    Customer[]
  employees    Employee[]
  appointments Appointment[]
  sales        Sale[]

  @@index([businessId])
  @@index([businessId, active])
}

model PlatformUser {
  id           String             @id @default(uuid()) @db.Uuid
  email        String             @unique
  passwordHash String
  status       PlatformUserStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  auditLogs    AuditLog[]         @relation("AuditLogPlatformUser")

  @@index([status])
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  businessId          String        @db.Uuid
  roleId              String        @db.Uuid
  username            String
  passwordHash        String
  status              UserStatus    @default(INVITED)
  mustChangePassword  Boolean       @default(true)
  isOwner             Boolean       @default(false)
  email               String?
  phone               String?
  displayName         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  role                Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employee            Employee?
  appointmentsCreated Appointment[] @relation("AppointmentCreatedBy")
  salesCreated        Sale[]        @relation("SaleCreatedBy")
  paymentsCreated     Payment[]     @relation("PaymentCreatedBy")
  auditLogs           AuditLog[]    @relation("AuditLogUser")

  @@unique([businessId, username])
  @@index([roleId])
  @@index([businessId, status])
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @db.Uuid
  name            String
  active          Boolean          @default(true)
  isSystemDefault Boolean          @default(false)
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  users           User[]
  permissions     RolePermission[]

  @@unique([businessId, name])
  @@index([businessId, active])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  module      String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  businessId   String        @db.Uuid
  branchId     String?       @db.Uuid
  name         String
  phone        String
  active       Boolean       @default(true)
  email        String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  sales        Sale[]

  @@unique([businessId, phone])
  @@index([branchId])
  @@index([businessId, active])
}

model Employee {
  id           String             @id @default(uuid()) @db.Uuid
  businessId   String             @db.Uuid
  branchId     String             @db.Uuid
  userId       String?            @unique @db.Uuid
  displayName  String
  active       Boolean            @default(true)
  phone        String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     EmployeeService[]
  schedules    EmployeeSchedule[]
  appointments Appointment[]
  sales        Sale[]

  @@index([businessId])
  @@index([branchId])
  @@index([businessId, active])
}

model Service {
  id                  String               @id @default(uuid()) @db.Uuid
  businessId          String               @db.Uuid
  name                String
  durationMinutes     Int
  price               Decimal              @db.Decimal(12, 2)
  active              Boolean              @default(true)
  description         String?
  category            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  employees           EmployeeService[]
  appointmentServices AppointmentService[]
  saleItems           SaleItem[]

  @@index([businessId, active])
  @@index([businessId, name])
}

model EmployeeService {
  employeeId String   @db.Uuid
  serviceId  String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
  @@index([serviceId])
}

model EmployeeSchedule {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @db.Uuid
  dayOfWeek  DayOfWeek
  startTime  DateTime  @db.Time(0)
  endTime    DateTime  @db.Time(0)
  active     Boolean   @default(true)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, dayOfWeek])
}

model Appointment {
  id                      String               @id @default(uuid()) @db.Uuid
  businessId              String               @db.Uuid
  branchId                String               @db.Uuid
  customerId              String               @db.Uuid
  employeeId              String               @db.Uuid
  createdByUserId         String?              @db.Uuid
  originalAppointmentId   String?              @db.Uuid
  status                  AppointmentStatus    @default(PENDING)
  source                  AppointmentSource
  startAt                 DateTime
  endAt                   DateTime
  notes                   String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  business                Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch                  Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer                Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  employee                Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdByUser           User?                @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  originalAppointment     Appointment?         @relation("AppointmentReschedules", fields: [originalAppointmentId], references: [id], onDelete: SetNull)
  rescheduledAppointments Appointment[]        @relation("AppointmentReschedules")
  services                AppointmentService[]
  sales                   Sale[]

  @@index([businessId, startAt])
  @@index([employeeId, startAt])
  @@index([employeeId, status, startAt])
  @@index([customerId, startAt])
  @@index([branchId, startAt])
  @@index([createdByUserId])
  @@index([originalAppointmentId])
}

model AppointmentService {
  id                      String      @id @default(uuid()) @db.Uuid
  appointmentId           String      @db.Uuid
  serviceId               String      @db.Uuid
  serviceNameSnapshot     String
  priceSnapshot           Decimal     @db.Decimal(12, 2)
  durationMinutesSnapshot Int
  appointment             Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  service                 Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@index([serviceId])
}

model Sale {
  id              String       @id @default(uuid()) @db.Uuid
  businessId      String       @db.Uuid
  branchId        String       @db.Uuid
  customerId      String?      @db.Uuid
  appointmentId   String?      @db.Uuid
  employeeId      String?      @db.Uuid
  createdByUserId String?      @db.Uuid
  status          SaleStatus   @default(DRAFT)
  subtotal        Decimal      @db.Decimal(12, 2)
  discountTotal   Decimal      @db.Decimal(12, 2)
  taxTotal        Decimal      @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  employee        Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdByUser   User?        @relation("SaleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           SaleItem[]
  payments        Payment[]
  receipt         Receipt?

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([branchId, createdAt])
  @@index([customerId])
  @@index([appointmentId])
  @@index([employeeId])
  @@index([createdByUserId])
}

model SaleItem {
  id           String       @id @default(uuid()) @db.Uuid
  saleId       String       @db.Uuid
  serviceId    String?      @db.Uuid
  type         SaleItemType
  description  String
  quantity     Int
  unitPrice    Decimal      @db.Decimal(12, 2)
  total        Decimal      @db.Decimal(12, 2)
  metadataJson Json?
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([serviceId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  saleId            String        @db.Uuid
  createdByUserId   String?       @db.Uuid
  method            PaymentMethod
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  externalReference String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  sale              Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdByUser     User?         @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([createdByUserId])
  @@index([status, createdAt])
}

model Receipt {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @db.Uuid
  saleId        String        @unique @db.Uuid
  receiptNumber String
  status        ReceiptStatus @default(PENDING)
  dataJson      Json
  generatedAt   DateTime
  pdfUrl        String?
  sentAt        DateTime?
  createdAt     DateTime      @default(now())
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([businessId, receiptNumber])
  @@index([businessId, status])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String?       @db.Uuid
  userId         String?       @db.Uuid
  platformUserId String?       @db.Uuid
  action         String
  entityType     String
  entityId       String?
  oldValueJson   Json?
  newValueJson   Json?
  metadataJson   Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())
  business       Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user           User?         @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
  platformUser   PlatformUser? @relation("AuditLogPlatformUser", fields: [platformUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([userId])
  @@index([platformUserId])
  @@index([entityType, entityId])
}
