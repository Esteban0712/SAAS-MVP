# Copy to a non-versioned .env.prod and replace every placeholder.
IMAGE_TAG=replace-with-immutable-release-id
API_IMAGE=deenova-api
MIGRATE_IMAGE=deenova-migrate
WEB_IMAGE=deenova-web

APP_HOST=staging.example.com
ACME_EMAIL=ops@example.com
FRONTEND_URL=https://staging.example.com

POSTGRES_DB=deenova
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-random-database-password
DATABASE_URL=postgresql://replace-with-user:replace-with-password@postgres:5432/deenova

JWT_SECRET=replace-with-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=deenova_session
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY_HOPS=1
